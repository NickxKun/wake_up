[node name="Desc" type="Label" parent="MainLayout/ContentMargin/ContentVBox/ScrollContainer/PanelsContainer/GuidePanel/LoreCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 12
text = "You awaken deep within an abandoned research habitat on the surface of an arid planetary outpost. Autonomous security drones have entered high-alert quarantine protocols and will neutralize any living entity on sight. Your objective is survival and sector pacification."
autowrap_mode = 2

[node name="SurvivalCard" type="PanelContainer" parent="MainLayout/ContentMargin/ContentVBox/ScrollContainer/PanelsContainer/GuidePanel"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card_panel")

