theme_override_font_sizes/font_size = 15
text = "PROTOCOL 01 // SURVIVAL DIRECTIVE"

[node name="Desc" type="Label" parent="MainLayout/ContentMargin/ContentVBox/ScrollContainer/PanelsContainer/GuidePanel/SurvivalCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 12
text = "• Drone spawns scale dynamically in frequency and density as time progresses.\n• Each drone destroyed increments your combat score and adds to your career tally.\n• Health does not passively regenerate—position carefully behind station structures.\n• Upon death, your run score records. Deaths persist across in-game restarts until returning to Title."
autowrap_mode = 2

